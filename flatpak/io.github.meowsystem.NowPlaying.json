{
  "id": "io.github.meowsystem.NowPlaying",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "meowsystem-now-playing",
  "finish-args": [
    "--socket=wayland",
    "--socket=session-bus",
    "--talk-name=org.mpris.MediaPlayer2.*",
    "--filesystem=xdg-cache:ro",
    "--filesystem=~/.var/app:ro",
    "--filesystem=xdg-config/cosmic:rw"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/meowsystem-now-playing/cargo"
    }
  },
  "modules": [
    {
      "name": "meowsystem-now-playing",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml --verbose",
        "cargo --offline build --release --verbose",
        "install -Dm0755 ./target/release/meowsystem-now-playing /app/bin/meowsystem-now-playing",
        "install -Dm0644 ./res/io.github.meowsystem.NowPlaying.desktop /app/share/applications/io.github.meowsystem.NowPlaying.desktop",
        "install -Dm0644 ./res/io.github.meowsystem.NowPlaying.metainfo.xml /app/share/metainfo/io.github.meowsystem.NowPlaying.metainfo.xml",
        "install -Dm0644 ./res/icons/hicolor/16x16/apps/io.github.meowsystem.NowPlaying.svg /app/share/icons/hicolor/16x16/apps/io.github.meowsystem.NowPlaying.svg",
        "install -Dm0644 ./res/icons/hicolor/24x24/apps/io.github.meowsystem.NowPlaying.svg /app/share/icons/hicolor/24x24/apps/io.github.meowsystem.NowPlaying.svg",
        "install -Dm0644 ./res/icons/hicolor/32x32/apps/io.github.meowsystem.NowPlaying.svg /app/share/icons/hicolor/32x32/apps/io.github.meowsystem.NowPlaying.svg",
        "install -Dm0644 ./res/icons/hicolor/48x48/apps/io.github.meowsystem.NowPlaying.svg /app/share/icons/hicolor/48x48/apps/io.github.meowsystem.NowPlaying.svg",
        "install -Dm0644 ./res/icons/hicolor/64x64/apps/io.github.meowsystem.NowPlaying.svg /app/share/icons/hicolor/64x64/apps/io.github.meowsystem.NowPlaying.svg",
        "install -Dm0644 ./res/icons/hicolor/128x128/apps/io.github.meowsystem.NowPlaying.svg /app/share/icons/hicolor/128x128/apps/io.github.meowsystem.NowPlaying.svg",
        "install -Dm0644 ./res/icons/hicolor/256x256/apps/io.github.meowsystem.NowPlaying.svg /app/share/icons/hicolor/256x256/apps/io.github.meowsystem.NowPlaying.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        },
        "cargo-sources.json"
      ]
    }
  ]
}
